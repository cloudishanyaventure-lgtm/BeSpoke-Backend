[Unit]
Description=BeSpoke Spring Boot backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=bespoke
WorkingDirectory=/opt/bespoke
# -Xmx trimmed to leave room for Postgres + OS on a small VM.
# 512m suits e2-small (2GB). Drop to 256m if you ever move to e2-micro (1GB).
Environment=JAVA_OPTS=-Xmx512m
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=DB_URL=jdbc:postgresql://localhost:5432/BeSpoke
Environment=DB_USERNAME=postgres
# --- CHANGE THESE before starting ---
Environment=DB_PASSWORD=postgres
Environment=JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
Environment=CORS_ALLOWED_ORIGINS=http://localhost:3000
# GCS bucket for uploaded images. Leave blank and they are written to
# /opt/bespoke/uploads on this VM instead — where they are one `rm -rf` or one
# rebuilt VM away from gone. See "Image uploads" in DEPLOY.md.
Environment=STORAGE_BUCKET=
# Only needed if this VM's own service account cannot write to the bucket
# (see DEPLOY.md option B). Path to a service-account JSON on this machine.
#Environment=GOOGLE_APPLICATION_CREDENTIALS=/opt/bespoke/gcs-key.json
# ------------------------------------
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/bespoke/app.jar
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
